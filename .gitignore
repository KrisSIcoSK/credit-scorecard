# ============================================================
# 风控项目 .gitignore
# 作用：告诉 Git「这些文件不要跟踪」，它们不会出现在仓库里
# ============================================================

# ---------- 本地临时文件 ----------
# 文件名以下划线开头的，一律当作本地草稿/中间产物，不上传
# （例如 _run.txt、_review_*.py、_step*.py、_fixed_output.txt）
_*

# ---------- Python 缓存 ----------
# 运行脚本时自动生成的字节码，不需要上传
__pycache__/
*.py[cod]
*$py.class

# ---------- 虚拟环境 ----------
# 第三方库，几百个文件几十 MB，绝对不要上传
# 别人 clone 后用 pip install -r requirements.txt 自己装即可
.venv/
venv/
env/
ENV/

# ---------- 打包产物 ----------
build/
dist/
*.egg-info/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- 编辑器与 IDE ----------
.vscode/
.idea/
*.swp

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 原始数据文件 ----------
# 体积大 + 版权原因，改成在 README 里提供下载地址
*.xls
*.xlsx
*.parquet
data/

# 注意：不要忽略 *.csv
# 因为 outputs/ 目录下的结果表（score_card.csv、rule_strategy.csv 等）
# 是要上传的 —— 它们是项目成果，也是 README 里引用的证据

# ---------- 日志与临时文件 ----------
*.log
*.tmp